      "isDeleted": false,
      "boundElements": null,
      "updated": 1762300000000,
      "link": null,
      "locked": false,
      "text": "projects guarda el proyecto y sus costos; el diagnóstico vive en project_faults y los repuestos usados en project_spare_parts.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "projects guarda el proyecto y sus costos; el diagnóstico vive en project_faults y los repuestos usados en project_spare_parts.",
      "lineHeight": 1.25,
      "baseline": 11.700000000000001
    }
  ],
